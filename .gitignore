node_modules/
dist/
.status/
*.log
# Server-owned backup snapshots (timestamped .bak.* files) and root-level
# runtime logs (job_log.txt, failed_log.txt, logs.txt) — per-server state,
# never commit. Root-only so real .txt files in subdirectories stay visible.
*.bak.*
/*.txt
.DS_Store
inbox/*.json
decisions/*.md
# Server-owned runtime data: the lesson ledger (WF-1), env-access log (WF-4), and
# human-approved routing rules / per-agent playbooks (WF-2). These are per-server
# state, not source — never commit them.
decisions/*.jsonl
decisions/routing-rules.json
decisions/playbooks/
server/hermes-*.md
docs/backlink-*.md
artifacts/
inputs/
workflow-runs/
# Goal aggregates (goals/<goalId>.json, ADR-006) are long-lived per-server runtime
# state — same class as inbox/ and workflow-runs/, and they carry private goal
# context (tokens paths, revenue targets). Never commit them.
goals/

# Business audit / ops-health reports dropped by dispatched agents. These are
# per-server runtime output carrying private business context (revenue targets,
# funnel state, tool health) — same class as goals/ and inbox/. Never commit them.
reports/

# Scratch/debug scripts — the server is TypeScript; stray .py files are local-only
# and have leaked private paths before. Keep them out of git. Dispatched agents
# occasionally drop working files (scripts, sqlite dbs, ComfyUI graphs) in the repo
# root despite the per-task cwd; ignore those at the ROOT only, so a real file in a
# subdirectory is never silently hidden.
server/*.py
/*.py
/*.db
/__pycache__/

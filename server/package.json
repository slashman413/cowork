    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.11",

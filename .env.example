# Google OAuth installed-app clients used to refresh Antigravity/Gemini tokens
# (agy quota meter in the server + deploy/remote-brain-client.mjs).
# These are the public client values the agy and Gemini CLIs ship with; they are
# intentionally NOT committed. Copy this file to ~/.cowork/oauth-clients.env
# (chmod 600) and fill it in, or export the same variables in the service env —
# process env wins over the file. Tried in this order; incomplete pairs are skipped.

# Optional explicit override, tried first.
AGY_CLIENT_ID=
AGY_CLIENT_SECRET=

# Antigravity CLI's installed-app client (primary for agy brains).
AGY_OAUTH_CLIENT_ID=
AGY_OAUTH_CLIENT_SECRET=

# Gemini CLI's Code Assist client (fallback for tokens issued by gemini-cli).
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=

# Systemd *template* unit for a remote-agent client — install on the REMOTE machine.
# One config file per agent: ~/.config/cowork-remote-agent/<name>.env
# Start with:  systemctl --user enable --now cowork-remote-agent@<name>
# Scale by adding more <name>.env files and starting more instances.
#
#   mkdir -p ~/.config/cowork-remote-agent
#   cp remote-agent-client.env.example ~/.config/cowork-remote-agent/fable.env  # then edit
#   cp cowork-remote-agent@.service    ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now cowork-remote-agent@fable

[Unit]
Description=Cowork remote-agent client (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/cowork-remote-agent/%i.env
# COWORK_CLIENT_JS is set in the env file to the absolute path of the script.
ExecStart=/usr/bin/env sh -c 'exec node "$COWORK_CLIENT_JS"'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
